{
  "name": "kavirox",
  "version": "1.0.0",
  "private": true,
  "description": "KAVIROX - Autonomous AI Systems, Cybersecurity & Impactful Digital Solutions",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:all": "tsx watch server/src/server.ts",
    "bundle": "esbuild src/main.ts --bundle --outfile=script.js --format=esm --target=es2020",
    "build:client": "npm run bundle && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server.js",
    "type-check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
