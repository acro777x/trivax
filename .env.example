# ==============================================================================
# KAVIROX.SPACE - Environment Variables Configuration
# ==============================================================================
# Security Standard: OWASP Top 10 for LLM Applications
# Store this in your Cloudflare Pages / Vercel / Netlify / Hostinger Environment Settings.
# NEVER commit your live .env with real API keys to public Git repositories!

# 1. OpenRouter API Key for KAVIROX AI Chatbot
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. OpenRouter Model (Default: poolside/laguna-s-2.1:free)
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# 3. Domain & App Identifiers for OpenRouter Ranking & Security
OPENROUTER_SITE_URL=https://kavirox.space
OPENROUTER_SITE_NAME=KAVIROX.SPACE

# 4. Contact Transmission Destination
CONTACT_EMAIL=info@kavirox.space
CONTACT_PHONE=+919548425711
